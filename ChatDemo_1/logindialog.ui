  <property name="styleSheet"><string notr="true">
QWidget#loginCard { background-color: rgba(255,255,255,225); border: 1px solid rgba(255,255,255,245); border-radius: 20px; }
QWidget#serverSettings QLabel { color: #28233a; }
QLabel#titleLabel { color: #201c31; }
QLabel#subtitleLabel { color: #625b74; }
QLabel#hintLabel { color: #766d8a; font-size: 12px; }
QLabel#captchaCodeLabel { color: #28233a; background-color: #eeeafa; border-radius: 9px; font: 700 17px Consolas; letter-spacing: 2px; }
QLineEdit { color: #28233a; background-color: rgba(255,255,255,244); border: 1px solid #ddd8ee; border-radius: 11px; padding: 8px 14px; selection-background-color: #8067d8; }
QLineEdit:focus { border: 1px solid #a990e7; background-color: #ffffff; }
QFrame#userField, QFrame#passwordField, QFrame#captchaField { background-color: rgba(255,255,255,244); border: 1px solid #ddd8ee; border-radius: 11px; }
QFrame#userField[focused="true"], QFrame#passwordField[focused="true"], QFrame#captchaField[focused="true"] { border: 1px solid #a990e7; background-color: #ffffff; }
QLineEdit#usernameEdit, QLineEdit#passwordEdit, QLineEdit#captchaEdit { background: transparent; border: none; border-radius: 0; padding: 0; }
QToolButton#eyeButton { background: transparent; border: none; padding: 0; }
QToolButton#eyeButton:hover { background: transparent; }
QPushButton#refreshCaptchaButton { color: #514673; background-color: rgba(255,255,255,190); border: 1px solid #e5e0ed; border-radius: 9px; padding: 6px; }
QPushButton#refreshCaptchaButton:hover { background-color: #eee8fc; }
QFrame#serverSummaryRow { background-color: rgba(255,255,255,210); border: 1px solid #e3dff0; border-radius: 11px; }
QPushButton#serverToggleButton { color: #5f587a; background: transparent; border: none; text-align: left; padding: 0; }
QPushButton#serverToggleButton:hover { color: #6e57cf; background: transparent; }
QLabel#serverAddressLabel { color: #756d91; }
QLabel#registrationInfoLabel { color: #756d91; }
QToolButton#serverChevronButton { color: #716697; background: transparent; border: none; }
QToolButton#serverChevronButton:hover { color: #6247c3; }
QPushButton#cancelButton { color: #786e8d; background: transparent; border: none; }
QPushButton#cancelButton:hover { color: #604cb0; }
QPushButton#loginButton { color: white; background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #8d6df0,stop:1 #7866df); border: none; border-radius: 12px; }
QPushButton#loginButton:hover { background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #997bf4,stop:1 #8371e8); }
QPushButton#loginButton:pressed { background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #785cd8,stop:1 #6655c7); }
QPushButton#loginButton:disabled { color: #f4f0fa; background-color: #c9bee7; border-color: #c9bee7; }
QCheckBox { color: #514b62; }
