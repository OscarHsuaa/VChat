<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1200</width><height>780</height></rect></property>
  <property name="minimumSize"><size><width>830</width><height>560</height></size></property>
  <property name="windowTitle"><string>VChat - 聊天室</string></property>
  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet"><string notr="true">
QWidget#centralwidget { background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #fbf8ff,stop:0.55 #f8f5ff,stop:1 #f1ebfc); color: #252044; font-family: "Microsoft YaHei UI"; }
HeaderWaveFrame#headerPanel { background: transparent; border: none; }
QFrame#chatPanel, QFrame#rightPanel { background-color: #ffffff; border: 1px solid #eee8f8; border-radius: 18px; }
QLabel#titleLabel { color: #252044; font-size: 23px; font-weight: 700; }
QLabel#subtitleLabel { color: #79718f; font-size: 13px; }
QLabel#onlineTitle { color: #252044; font-size: 16px; font-weight: 600; }
QLabel#onlineBadge { color: #6c52bc; padding: 6px 12px; font-size: 12px; font-weight: 600; }
QLabel#serverStatusLabel, QLabel#onlineCountLabel { color: #756e8c; font-size: 12px; }
QScrollArea#messageScroll { background-color: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 4px 1px; }
QScrollBar::handle:vertical { background: #dcd2f2; border-radius: 4px; min-height: 26px; }
QScrollBar::handle:vertical:hover { background: #baa9e7; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QWidget#messageContainer { background-color: transparent; }
QListWidget#userList { background-color: transparent; border: none; outline: none; }
QListWidget#userList::item { background-color: transparent; border-radius: 12px; }
QListWidget#userList::item:hover { background-color: #f7f4fc; }
QFrame#composer { background-color: #ffffff; border-top: 1px solid #eee8f8; }
QLineEdit#messageInput { color: #252044; background-color: #ffffff; border: 1px solid #e4ddf3; border-radius: 13px; padding: 9px 16px; selection-background-color: #8064d9; font-size: 14px; }
QLineEdit#messageInput:focus { border: 1px solid #9875e8; }
QPushButton#sendButton { color: white; background: qlineargradient(x1:0,y1:0,x2:1,y2:1,stop:0 #9068f3,stop:1 #7457d8); border: none; border-radius: 13px; padding: 8px 13px; font-size: 15px; font-weight: 600; }
QPushButton#sendButton:hover { background: #9574ee; }
QPushButton#sendButton:pressed { background: #694cc8; }
QPushButton#sendButton:disabled { color:#f8f6fc; background: #c5b7e6; }
QPushButton#settingsButton, QPushButton#helpButton, QPushButton#exitButton { color: #4d4279; background: transparent; border: none; border-radius: 9px; padding: 7px 9px; font-size: 13px; }
QPushButton#settingsButton:hover, QPushButton#helpButton:hover, QPushButton#exitButton:hover { background-color: #eee8fb; }
QFrame#infoDivider { background-color: #eee8f8; border: none; }
   </string></property>
